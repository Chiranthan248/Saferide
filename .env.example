# Environment Variables for SafeRide
# Copy this file to .env and fill in the values.
# Never commit your .env file to version control.

# --- Django ---
# Generate a unique value with Django's get_random_secret_key helper.
SECRET_KEY=replace-with-a-unique-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database (leave blank to use default SQLite3) ---
# DATABASE_URL=postgres://user:password@localhost:5432/saferide

# --- Email (for alerts in production) ---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your@email.com
# EMAIL_HOST_PASSWORD=your-email-password
